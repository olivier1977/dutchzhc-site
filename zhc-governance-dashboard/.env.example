# ============================================================
# zhc-governance-dashboard — Environment Variables
# Copy to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Node -----------------------------------------------
NODE_ENV=development

# ---- Database -------------------------------------------
DATABASE_URL=postgresql://zhcgov:zhcgov_dev@localhost:5432/zhcgov_dev

# ---- JWT (RS256) ----------------------------------------
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=https://governance.dutchzhc.com

# ---- Cookies --------------------------------------------
# Generate with: openssl rand -hex 32
COOKIE_SECRET=change_me_to_a_32_char_min_random_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- OAuth — Google ------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ---- OAuth — GitHub ------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# ---- App -----------------------------------------------
APP_FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
