    "fastify": "^4.27.0",
    "jose": "^5.3.0",
    "nanoid": "^5.0.7",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "drizzle-kit": "^0.22.7",
